# TEMPLATE ONLY: copy into a protected location outside the repository.
# Required secrets must be set through the server's intended credential mechanism.
DATABASE_URL=
BOT_TOKEN=
MINI_APP_URL=https://your-domain.example
ALLOWED_ORIGINS=["https://your-domain.example"]
ALLOWED_HOSTS=["your-domain.example"]
ADMIN_IDS=[]
AUTH_MAX_AGE=300
SESSION_SECONDS=3600
# public_viewer uses only normal public search/canonical timetable requests; no crawl.
# robots opts into strict robots.txt crawler policy, which currently blocks source search.
SOURCE_ACCESS_MODE=public_viewer
SOURCE_TTL_SECONDS=900
SOURCE_MAX_AGE_SECONDS=86400
SOURCE_TIMEOUT_SECONDS=15
SOURCE_REQUEST_SPACING=1.0
WORKER_INTERVAL_SECONDS=20
